APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Operations: use strong secrets and an off-server backup disk in production.
OPS_READINESS_TOKEN=
OPS_BACKUP_DISK=local
OPS_BACKUP_DIRECTORY=backups
OPS_BACKUP_PASSWORD=
# Windows/Laragon example: C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysqldump.exe
OPS_MYSQLDUMP_BINARY=mysqldump
OPS_BACKUP_RETENTION_DAYS=30
OPS_BACKUP_MAX_AGE_HOURS=26
OPS_DISK_WARNING_PERCENT=80
OPS_DISK_CRITICAL_PERCENT=90
OPS_QUEUE_OLDEST_MINUTES=10

# Go-live evidence. Fill only after the named drill has actually passed.
RELEASE_FEATURE_FREEZE=false
RELEASE_OWNER=
RELEASE_APPROVED_AT=
RELEASE_INITIAL_BACKUP_PATH=
RELEASE_RESTORE_DRILL_AT=
RELEASE_LOAD_TEST_REPORT=
RELEASE_ALERT_TESTED_AT=
RELEASE_PRODUCTION_SMOKE_AT=
RELEASE_MIDTRANS_CERTIFIED_AT=
RELEASE_RAJAONGKIR_CERTIFIED_AT=
RELEASE_EMAIL_CERTIFIED_AT=
RELEASE_WHATSAPP_REQUIRED=false
RELEASE_WHATSAPP_CERTIFIED_AT=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_MODE=sandbox
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_CONNECT_TIMEOUT=5
MIDTRANS_TIMEOUT=30
MIDTRANS_SAFE_RETRY_TIMES=2
MIDTRANS_SAFE_RETRY_SLEEP=250

RAJAONGKIR_MODE=sandbox
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
RAJAONGKIR_API_KEY=
RAJAONGKIR_COURIERS=jne:sicepat:jnt
RAJAONGKIR_TRACKING_CACHE_MINUTES=15
RAJAONGKIR_CONNECT_TIMEOUT=5
RAJAONGKIR_TIMEOUT=20
RAJAONGKIR_SAFE_RETRY_TIMES=2
RAJAONGKIR_SAFE_RETRY_SLEEP=250

WA_GATEWAY_MODE=sandbox
WA_GATEWAY_URL=https://wa-gateway.dokterkoding.my.id
WA_GATEWAY_TOKEN=
WA_GATEWAY_TIMEOUT=10
WA_GATEWAY_RETRY_TIMES=1
WA_GATEWAY_RETRY_SLEEP=200

# Controlled smoke-test recipients. Keep production disabled unless explicitly approved.
INTEGRATION_SMOKE_EMAIL_ALLOWLIST=
INTEGRATION_SMOKE_WHATSAPP_ALLOWLIST=
INTEGRATION_SMOKE_ALLOW_PRODUCTION=false
